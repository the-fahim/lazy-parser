
# Generic .gitignore for this CMake/C++ project

# Build artifacts
/build/
/bin/
/lib/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/Makefile
/Testing/

# Compiled object files, libraries and executables
*.o
*.obj
*.lo
*.la
*.al
*.lai
*.a
*.so
*.dylib
*.dll
*.exe

# Generated executables (local targets)
lazyparser
lazyparser_generator
test_grammar
test_parser
test_utils

# IDE/editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.iml

# Logs and temporary files
*.log
*.tmp
*.temp
*~
*.swp

# OS files
.DS_Store
Thumbs.db

# Coverage and test outputs
coverage/
*.gcno
*.gcda
*.lcov
.nyc_output/

# Python artifacts (examples/tools may contain Python)
__pycache__/
*.py[cod]
venv/
env/

# Misc
tags
cscope.*

